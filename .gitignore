# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage
.pytest_cache/
.coverage

# mypy
.mypy_cache/

# PyCharm
.idea/

# macOS
.DS_Store

# Intermediate pipeline artifacts, regenerable from the snapshot via
# `make parse`. Also holds ad hoc fetched texts. Not published.
# Leading slash anchors this to the repo root -- a bare `data/` would also
# match docs/data/, which is published and must stay tracked.
/data/

# The snapshot track's output. tree.json IS committed -- GitHub Pages serves it
# -- but this one is a local cross-check against the third-party Feb-2025
# scrape, reachable only via `make serve-snapshot`. 10.6 MB of nothing anyone
# fetches, and it dies with the rest of the snapshot track.
/docs/data/snapshot_tree.json
# Likewise the snapshot track's changelog. changelog.json IS committed; this
# one is the same curve over the 18-month-old scrape, built only to diff
# against it, and nothing serves it.
/docs/data/snapshot_changelog.json

# A git bundle of this repo's history plus a plain-text digest, kept locally
# as a backup. Large, redundant with the repo itself, and never published.
/notes/githistory/
